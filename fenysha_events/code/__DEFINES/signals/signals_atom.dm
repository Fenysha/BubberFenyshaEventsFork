/// Fired when an atom's color changes.
/// Args: (old_color, new_color)
#define COMSIG_ATOM_COLOR_CHANGED "atom_color_changed"

/// Fired when an atom's base_color is set or changed.
/// Args: (old_base_color, new_base_color)
#define COMSIG_ATOM_BASE_COLOR_CHANGED "atom_base_color_changed"

/// Fired after any color modulation / tint operation finishes.
/// Args: (old_color, new_color, amount)
#define COMSIG_ATOM_COLOR_MODULATED "atom_color_modulated"

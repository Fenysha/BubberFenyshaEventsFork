// Which screen objects move as one when the chat browser is sitting over them.

/datum/hud/human/get_displacement_groups()
	return list(
		// Right-side status column
		list(HUD_MOB_HEALTH, HUD_MOB_HEALTHDOLL, HUD_MOB_STAMINA, HUD_MOB_SPACESUIT,
			HUD_MOB_MOOD, HUD_MOB_HUNGER, HUD_MOB_BLOOD_LEVEL, HUD_MOB_STYLE_METER),
		// Bottom-right controls
		list(HUD_MOB_INTENTS, HUD_MOB_MOVE_INTENT, HUD_MOB_ZONE_SELECTOR,
			HUD_MOB_THROW, HUD_MOB_CRAFTING_MENU, HUD_MOB_NAVIGATE_MENU,
			HUD_MOB_MEMORIES, HUD_MOB_PULL, HUD_MOB_AREA_CREATOR, HUD_MOB_COMBO,
			HUD_MOB_REST, HUD_MOB_SLEEP, HUD_MOB_RESIST,
			HUD_MOB_FLOOR_CHANGER, HUD_MOB_LANGUAGE_MENU),
		// Clothing grid
		list(HUD_KEY_ITEM_SLOT(ITEM_SLOT_OCLOTHING), HUD_KEY_ITEM_SLOT(ITEM_SLOT_ICLOTHING),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_GLOVES), HUD_KEY_ITEM_SLOT(ITEM_SLOT_EYES),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_EARS), HUD_KEY_ITEM_SLOT(ITEM_SLOT_MASK),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_HEAD), HUD_KEY_ITEM_SLOT(ITEM_SLOT_FEET),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_NECK), HUD_HUMAN_TOGGLE_INVENTORY),
		// Item bar
		list(HUD_KEY_ITEM_SLOT(ITEM_SLOT_ID), HUD_KEY_ITEM_SLOT(ITEM_SLOT_BELT),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_BACK), HUD_KEY_ITEM_SLOT(ITEM_SLOT_SUITSTORE),
			HUD_KEY_ITEM_SLOT(ITEM_SLOT_LPOCKET), HUD_KEY_ITEM_SLOT(ITEM_SLOT_RPOCKET),
			HUD_KEY_HAND_SLOT(1), HUD_KEY_HAND_SLOT(2),
			HUD_MOB_SWAPHAND_1, HUD_MOB_SWAPHAND_2, HUD_MOB_DROP),
	)


/datum/hud/ghost/get_displacement_groups()
	var/list/hudboxes = list()
	for(var/index in 1 to 10) // covers every hudbox subtype with room to spare
		hudboxes += HUD_KEY_GHOST_HUDBOX(index)
	return list(
		list(HUD_GHOST_SPAWNERS, HUD_GHOST_ORBIT, HUD_GHOST_REENTER_CORPSE,
			HUD_GHOST_DNR, HUD_GHOST_TELEPORT, HUD_GHOST_SETTINGS,
			HUD_GHOST_MINIGAMES, HUD_MOB_LANGUAGE_MENU, HUD_MOB_FLOOR_CHANGER),
		hudboxes,
	)
